agent/sessions/
agent/tmp/
agent/intercom/
agent/git/
agent/bin/
agent/packages/
agent/npm/
agent/generated-images/
agent/fff/

# node_modules anywhere
**/node_modules/

# logs
**/*.log
**/.DS_Store
