{
  "extensions": [
    "~/.pi/agent/extensions/news.ts",
    "~/.pi/agent/extensions/web-fetch.ts",
    "~/.pi/agent/extensions/questionnaire.ts",
    "~/.pi/agent/extensions/tps-meter.ts"
  ],
  "defaultModel": "claude-sonnet-4-6",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "low",
  "editorPaddingX": 2,
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "quietStartup": false,
  "lastChangelogVersion": "0.78.0",
  "memory": {
    "consolidationModel": "anthropic/claude-sonnet-4-6"
  },
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "model": "anthropic/claude-sonnet-4-6",
        "thinking": "high",
        "fallbackModels": [
          "anthropic/claude-haiku-4-5"
        ]
      }
    }
  },
  "packages": [
    "npm:pi-bar",
    "npm:context-mode",
    "npm:pi-total-recall",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 80
  },
  "plugins": [],
  "theme": "dark",
  "transport": "auto"
}