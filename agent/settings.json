{
  "defaultModel": "claude-sonnet-4-6",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "low",
  "editorPaddingX": 2,
  "enableInstallTelemetry": true,
  "extensions": [
    "~/.pi/agent/extensions/caffeinate.ts",
    "~/.pi/agent/extensions/context-viewer.ts",
    "~/.pi/agent/extensions/questionnaire.ts",
    "~/.pi/agent/extensions/research.ts",
    "~/.pi/agent/extensions/ship.ts",
    "~/.pi/agent/extensions/workflow.ts"
  ],
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": true,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "0.78.1",
  "memory": {
    "consolidationModel": "anthropic/claude-sonnet-4-6"
  },
  "packages": [
    "npm:context-mode",
    "npm:pi-total-recall",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:pi-zentui",
    "npm:pi-codex-image-gen"
  ],
  "plugins": [],
  "quietStartup": false,
  "showHardwareCursor": true,
  "subagents": {},
  "terminal": {
    "imageWidthCells": 80,
    "showTerminalProgress": true
  },
  "theme": "dark",
  "transport": "auto",
  "treeFilterMode": "default"
}