{
  "defaultModel": "gpt-5.5",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "low",
  "editorPaddingX": 2,
  "enableInstallTelemetry": true,
  "extensions": [
    "~/.pi/agent/extensions/context-viewer.ts",
    "~/.pi/agent/extensions/questionnaire.ts",
    "~/.pi/agent/extensions/ship.ts",
    "~/.pi/agent/extensions/workflow.ts"
  ],
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": true,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "0.79.1",
  "memory": {
    "consolidationModel": "gpt-5.5"
  },
  "packages": [
    "npm:pi-zentui",
    "npm:pi-hashline-edit",
    "npm:@ff-labs/pi-fff",
    "npm:@ollama/pi-web-search"
  ],
  "plugins": [],
  "quietStartup": false,
  "showHardwareCursor": true,
  "subagents": {},
  "terminal": {
    "imageWidthCells": 80,
    "showTerminalProgress": true
  },
  "theme": "dark",
  "transport": "auto",
  "treeFilterMode": "default"
}